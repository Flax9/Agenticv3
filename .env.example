# Salin menjadi .env (jangan di-commit) lalu isi nilainya.
DEBUG=True
# Daftar origin yang boleh mengakses API langsung (format JSON)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# LLM (OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-placeholder
# Dipakai modul contract (modul lain masih memakai nama model yang ditulis langsung di kode)
LLM_MODEL_NAME=qwen/qwen3-7b-flash

# Qdrant — development memakai Qdrant Cloud; di Docker: http://qdrant:6333
QDRANT_CLUSTER_ENDPOINT=
QDRANT_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-minilm-l6-v2

# Database PostgreSQL development (docker compose -f compose.dev.yml --env-file .env up -d)
POSTGRES_DB=pertamina_db
POSTGRES_USER=pertamina_user
POSTGRES_PASSWORD=ganti_dengan_password_kuat
DATABASE_URL=postgresql+asyncpg://pertamina_user:ganti_dengan_password_kuat@localhost:5432/pertamina_db
# Database terpisah untuk pytest (dibuat otomatis oleh deploy/postgres/init-test-db.sql)
TEST_DATABASE_URL=postgresql+asyncpg://pertamina_user:ganti_dengan_password_kuat@localhost:5432/pertamina_test

# Autentikasi
JWT_SECRET=ganti_dengan_string_acak_minimal_32_karakter
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7
# false hanya untuk development via http://localhost; produksi (HTTPS) wajib true
COOKIE_SECURE=false
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# Dipakai sekali oleh: uv run python -m app.scripts.seed admin
ADMIN_INITIAL_PASSWORD=ganti_minimal_10_karakter

# Berkas sementara hasil generate (default: <root>/output)
# OUTPUT_DIR=/app/output
MAX_UPLOAD_MB=100

# Opsional: tracing LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Pertamina_AI
